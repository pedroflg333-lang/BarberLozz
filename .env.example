# Backend URL — the Node.js/Express server that proxies Supabase and runs the AI lab
# In development, this is typically http://localhost:4000
# In production, replace with your deployed backend URL
VITE_BACKEND_URL=http://localhost:4000

# Supabase configuration (get these from your Supabase project dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
